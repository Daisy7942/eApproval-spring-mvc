<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.eapproval.employee.dao.EmployeeMapper">


   <select id="selectUserById" parameterType="string" resultType="employee">
      SELECT 
         employee_id,
         employee_code,
         name,
         email,
         role
      FROM employee
      WHERE employee_code = #{employee_code}
   </select>

</mapper>